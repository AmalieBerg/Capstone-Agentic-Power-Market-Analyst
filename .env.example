# Copy this file to ".env" and fill in your values. NEVER commit .env.
# Locally: used via python-dotenv. On Render: set these as Environment Variables instead.

COHERE_API_KEY=          # Cohere trial key (embeddings)
GROQ_API_KEY=            # Groq (primary LLM)
GEMINI_API_KEY=          # Google AI Studio / Gemini (fallback LLM)
ENTSOE_API_TOKEN=        # ENTSO-E Transparency Platform API token
DATABASE_URL=            # Neon connection string, e.g. postgresql://user:pass@host/db?sslmode=require
GUARDIAN_API_KEY=        # Guardian Open Platform (Sprint 2, optional)
